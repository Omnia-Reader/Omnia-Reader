{
  "name": "omnia-reader-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/omnia-reader-e2e/src",
  "implicitDependencies": ["omnia-reader"],
  "// targets": "to see all targets run: nx show project omnia-reader-e2e --web",
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "parallelism": true,
      "dependsOn": [
        {
          "projects": ["omnia-reader"],
          "target": "build"
        }
      ],
      "options": {
        "cwd": "apps/omnia-reader-e2e",
        "command": "playwright test"
      }
    },
    "performance": {
      "executor": "nx:run-commands",
      "parallelism": false,
      "dependsOn": [
        {
          "projects": ["omnia-reader"],
          "target": "build"
        }
      ],
      "options": {
        "command": "PERFORMANCE_E2E=1 playwright test --config apps/omnia-reader-e2e/playwright.config.ts --project=chromium --workers=1 performance.spec.ts"
      }
    },
    "performance-management-smoke": {
      "executor": "nx:run-commands",
      "parallelism": false,
      "dependsOn": [
        {
          "projects": ["omnia-reader"],
          "target": "build"
        }
      ],
      "options": {
        "command": "PERFORMANCE_MANAGEMENT_SMOKE=1 playwright test --config apps/omnia-reader-e2e/playwright.config.ts --project=chromium --workers=1 performance-management.spec.ts"
      }
    },
    "performance-management-dataset-smoke": {
      "executor": "nx:run-commands",
      "parallelism": false,
      "dependsOn": [
        {
          "projects": ["omnia-reader"],
          "target": "build"
        }
      ],
      "options": {
        "command": "PERFORMANCE_MANAGEMENT_DATASET_SMOKE=1 playwright test --config apps/omnia-reader-e2e/playwright.config.ts --project=chromium --workers=1 performance-management.spec.ts"
      }
    },
    "performance-management-branch-smoke": {
      "executor": "nx:run-commands",
      "parallelism": false,
      "dependsOn": [
        {
          "projects": ["omnia-reader"],
          "target": "build"
        }
      ],
      "options": {
        "command": "PERFORMANCE_MANAGEMENT_BRANCH_SMOKE=1 node node_modules/@playwright/test/cli.js test --config apps/omnia-reader-e2e/playwright.config.ts --project=chromium --workers=1 performance-management.spec.ts"
      }
    },
    "performance-desktop-web": {
      "executor": "nx:run-commands",
      "parallelism": false,
      "options": {
        "command": "node apps/omnia-reader-e2e/performance/run-desktop-web.mjs"
      }
    },
    "performance-evidence-test": {
      "executor": "nx:run-commands",
      "parallelism": false,
      "options": {
        "command": "node --test apps/omnia-reader-e2e/performance/validate-profile.spec.mjs apps/omnia-reader-e2e/performance/performance-evidence.spec.mjs apps/omnia-reader-e2e/performance/management-workload.spec.mjs apps/omnia-reader-e2e/performance/management-dataset.spec.mjs apps/omnia-reader-e2e/performance/page-measurement.spec.mjs apps/omnia-reader-e2e/performance/primary-management-run.spec.mjs apps/omnia-reader-e2e/performance/sampling-identity.spec.mjs apps/omnia-reader-e2e/performance/platform-lifecycle.spec.mjs apps/omnia-reader-e2e/performance/artifact-identity.spec.mjs apps/omnia-reader-e2e/performance/android-emulator-controller.spec.mjs apps/omnia-reader-e2e/performance/mobile-web-environment.spec.mjs apps/omnia-reader-e2e/performance/run-desktop-web.spec.mjs"
      }
    },
    "native": {
      "executor": "nx:run-commands",
      "parallelism": false,
      "options": {
        "commands": [
          "npm run tauri -- build --debug --no-bundle --features native-e2e",
          "node apps/omnia-reader-e2e/src/native/run-native-e2e.mjs"
        ],
        "parallel": false
      }
    },
    "native-linux-package": {
      "executor": "nx:run-commands",
      "parallelism": false,
      "options": {
        "commands": [
          "npm run tauri -- build --debug --bundles deb --features native-e2e",
          "node apps/omnia-reader-e2e/src/native/run-linux-package-e2e.mjs"
        ],
        "parallel": false
      }
    }
  }
}
