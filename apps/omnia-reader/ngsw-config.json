{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/main-*.js",
          "/*.css"
        ]
      }
    },
    {
      "name": "offline-app-code",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/*.js"]
      }
    },
    {
      "name": "offline-reader-assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/pdfjs/**"]
      }
    },
    {
      "name": "lazy-fonts",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/media/**"]
      }
    },
    {
      "name": "static-assets",
      "installMode": "prefetch",
      "resources": {
        "files": ["/assets/**", "!/assets/pdfjs/**"]
      }
    }
  ]
}
