# Copy this file to apps/sync-gateway/.env.local. Never commit the copied file.
# Create the GitHub App as documented in docs/sync-gateway-api.md.
OMNIA_GITHUB_APP_ID=replace-with-numeric-app-id
OMNIA_GITHUB_CLIENT_ID=replace-with-client-id
OMNIA_GITHUB_CLIENT_SECRET=replace-with-client-secret
OMNIA_GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nreplace-with-generated-private-key\n-----END RSA PRIVATE KEY-----"
OMNIA_GITHUB_CALLBACK_URL=http://localhost:4300/api/sync/github/auth/callback
OMNIA_GITHUB_INSTALLATION_URL=https://github.com/apps/replace-with-app-slug/installations/new

# Optional: metadata/API deadline (default 60 seconds) and whole-transfer
# deadline (default 6 hours). Keep enough time for the largest supported book.
# OMNIA_GITHUB_REQUEST_TIMEOUT_MS=60000
# OMNIA_GITHUB_TRANSFER_TIMEOUT_MS=21600000

# Production webhook only. Generate independently with: openssl rand -base64 32
# OMNIA_GITHUB_WEBHOOK_SECRET=replace-with-independent-webhook-secret

# Generate with: openssl rand -base64 32
OMNIA_SYNC_SESSION_KEY=replace-with-base64-32-byte-key

# Persists encrypted sessions across local gateway restarts. Single process only.
OMNIA_SYNC_SESSION_DIRECTORY=apps/sync-gateway/.session-data
