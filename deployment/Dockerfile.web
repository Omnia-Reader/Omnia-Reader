ARG NODE_IMAGE=node:26.5.0-bookworm-slim@sha256:2d49d876e96237d76de412761cf05dbfe5aee325cc4406a4d41d5824c5bb8beb
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.29.5-alpine@sha256:42a7d7f2ee23e9f5a1dcdf3647ba5c585bbd18f79e79cd817e70e8cd61c55779

FROM ${NODE_IMAGE} AS build

WORKDIR /source
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

RUN npx nx build omnia-reader --configuration production --skip-nx-cache \
    && node tools/render-nginx-security-headers.mjs > /tmp/security-headers.conf

FROM ${NGINX_IMAGE} AS runtime

ARG OMNIA_VERSION=0.1.0
ARG OMNIA_REVISION=unknown

LABEL org.opencontainers.image.title="Omnia Reader web application" \
      org.opencontainers.image.description="Installable EPUB and PDF reader with same-origin synchronization" \
      org.opencontainers.image.source="https://github.com/omnia-reader/omnia-reader" \
      org.opencontainers.image.version="${OMNIA_VERSION}" \
      org.opencontainers.image.revision="${OMNIA_REVISION}"

COPY deployment/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /tmp/security-headers.conf /etc/nginx/security-headers.conf
COPY --from=build /source/dist/apps/omnia-reader/browser /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=6 \
  CMD ["wget", "--quiet", "--spider", "http://127.0.0.1:8080/"]
