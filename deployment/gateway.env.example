# Copy this file to deployment/gateway.env. Keep the real file untracked and
# readable only by the account that operates the containers.

# Required once either provider is enabled. Generate 32 random bytes:
# openssl rand -base64 32
OMNIA_SYNC_SESSION_KEY=
OMNIA_SYNC_NATIVE_REDIRECT_SCHEME=omnia-reader

# Optional shared store. Required for multiple gateway replicas.
# OMNIA_SYNC_REDIS_URL=rediss://user:password@redis.example:6379/0
# OMNIA_SYNC_REDIS_PREFIX=omnia-reader

# GitHub App configuration. Leave every value empty to keep GitHub disabled.
OMNIA_GITHUB_APP_ID=
OMNIA_GITHUB_CLIENT_ID=
OMNIA_GITHUB_CLIENT_SECRET=
OMNIA_GITHUB_PRIVATE_KEY=
OMNIA_GITHUB_CALLBACK_URL=https://reader.example/api/sync/github/auth/callback
OMNIA_GITHUB_INSTALLATION_URL=https://github.com/apps/omnia-reader/installations/new
# OMNIA_GITHUB_WEBHOOK_SECRET=
# OMNIA_GITHUB_REQUEST_TIMEOUT_MS=60000
# OMNIA_GITHUB_TRANSFER_TIMEOUT_MS=21600000

# MEGA remains optional and secondary.
# OMNIA_MEGA_LOGIN_URL=https://reader.example/api/sync/mega/login
# OMNIA_MEGA_SDK_BRIDGE_URL=http://mega-sdk-bridge:47831
# OMNIA_MEGA_SDK_BRIDGE_TOKEN=
