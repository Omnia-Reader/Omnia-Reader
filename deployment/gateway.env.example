# Copy this file to deployment/gateway.env. Keep the real file untracked and
# readable only by the account that operates the containers.

# Required once either provider is enabled. Generate 32 random bytes:
# openssl rand -base64 32
OMNIA_SYNC_SESSION_KEY=
OMNIA_SYNC_NATIVE_REDIRECT_SCHEME=omnia-reader

# Required when any provider is enabled in production. Development may omit it
# for process-local sessions or use OMNIA_SYNC_SESSION_DIRECTORY for one node.
OMNIA_SYNC_REDIS_URL=rediss://user:password@redis.example:6379/0
OMNIA_SYNC_REDIS_PREFIX=omnia-reader

# Internal /metrics alert gauges use these bounded, low-cardinality thresholds.
# Keep /metrics on the private gateway network; only /healthz and /readyz are
# intended for the public reverse proxy.
OMNIA_SYNC_ALERT_MIN_REQUESTS=20
OMNIA_SYNC_ALERT_MAX_FAILURE_RATIO=0.05
OMNIA_SYNC_ALERT_MAX_P95_MS=2000
OMNIA_SYNC_ALERT_MAX_READINESS_FAILURES=0

# GitHub App configuration. Leave every value empty to keep GitHub disabled.
OMNIA_GITHUB_APP_ID=
OMNIA_GITHUB_CLIENT_ID=
OMNIA_GITHUB_CLIENT_SECRET=
OMNIA_GITHUB_PRIVATE_KEY=
OMNIA_GITHUB_CALLBACK_URL=https://reader.example/api/sync/github/auth/callback
OMNIA_GITHUB_INSTALLATION_URL=https://github.com/apps/omnia-reader/installations/new
# OMNIA_GITHUB_WEBHOOK_SECRET=
# OMNIA_GITHUB_REQUEST_TIMEOUT_MS=60000
# OMNIA_GITHUB_TRANSFER_TIMEOUT_MS=21600000

# MEGA remains optional and secondary.
# OMNIA_MEGA_LOGIN_URL=https://reader.example/api/sync/mega/login
# OMNIA_MEGA_SDK_BRIDGE_URL=http://mega-sdk-bridge:47831
# OMNIA_MEGA_SDK_BRIDGE_TOKEN=

# Protected release automation inputs. Do not pass these into the web or
# gateway containers. The trusted absolute-path driver receives only candidate
# identity plus logical artifact names and sha256 digests on standard input. It
# must map those names to protected registry repositories, deploy the exact
# digests without rebuilding or retagging, and return a sanitized JSON receipt.
OMNIA_SYNC_PROMOTION_DRIVER=/opt/omnia-reader/bin/sync-promotion-driver

# Inject this only for scan-sync-evidence.mjs as a protected JSON object of
# canary-id to secret-value mappings; never commit or persist the real value.
# OMNIA_SYNC_SECRET_CANARIES=
